# Copia este archivo como ".env". NUNCA subas el .env a GitHub.

# Clave para firmar las sesiones: genera una con  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto
# Clave del panel de administración (/admin)
ADMIN_CLAVE=cambia-esto-tambien

# Correo de confirmación (opcional). Sin SMTP_HOST, los correos se muestran en la consola.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=tu_correo@gmail.com
# SMTP_CLAVE=contraseña_de_aplicacion
# SMTP_REMITENTE=tu_correo@gmail.com
